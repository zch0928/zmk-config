/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "macro8";
    compatible = "macro8";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,underglow = &led_strip;
    };

    /* 按键矩阵变换（8键，4×2布局）*/
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        map = 
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        >;
    };

    /* 按键扫描（直连GPIO）*/
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
            = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K1 P1.11 Pin1  */
            , <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K2 P1.10 Pin2  */
            , <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K3 P0.03 Pin3  */
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K4 P1.13 Pin7  */
            , <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K5 P0.13 Pin33 */
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K6 P0.22 Pin34 */
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K7 P0.24 Pin35 */
            , <&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* K8 P1.00 Pin36 */
            ;
    };

    /* 模式切换键 */
    mode_button: mode_button {
        compatible = "gpio-keys";
        mode_key: mode_key {
            gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* SW2 P1.02 Pin38 */
            label = "Mode Switch";
        };
    };

    /* 电池电量检测 */
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        label = "VBATT";
        io-channels = <&adc 7>;          /* AI7 Pin10 */
        output-ohms = <100000>;
        full-ohms = <200000>;
    };

    /* 充电状态检测 */
    charge_detect: charge_detect {
        compatible = "gpio-keys";
        chrg_pin: chrg_pin {
            gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* CHRG# P0.06 Pin14 */
            label = "Charging";
        };
        stdby_pin: stdby_pin {
            gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* STDBY# P0.08 Pin16 */
            label = "Standby";
        };
    };
};

/* USB */
&usbd {
    status = "okay";
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/* RTC 低频晶振 */
&lfxo {
    status = "okay";
};

/* ADC */
&adc {
    status = "okay";
};

/* GPIO */
&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

/* SPI → GL5050 RGB LED */
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    mosi-pin = <26>;  /* P0.26 Pin12 → GL5050 DIN */
    sck-pin  = <99>;  /* 虚拟，单总线不需要 SCK */
    cs-gpios = <>;

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "WS2812";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame  = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping  = <LED_COLOR_ID_RED
                          LED_COLOR_ID_GREEN
                          LED_COLOR_ID_BLUE>;
    };
};

/* Flash 分区 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells    = <1>;

        sd_partition: partition@0 {
            label = "mbr";
            reg   = <0x00000000 0x00001000>;
        };
        code_partition: partition@1000 {
            label = "code";
            reg   = <0x00001000 0x000d3000>;
        };
        storage_partition: partition@d4000 {
            label = "storage";
            reg   = <0x000d4000 0x00020000>;
        };
        boot_partition: partition@f4000 {
            label = "adafruit_boot";
            reg   = <0x000f4000 0x0000c000>;
        };
    };
};