#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        /* K1：打开 Claude Code */
        macro_claude: macro_claude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp L &kp A &kp U &kp D &kp E &kp RET>;
        };

        /* K2：粘贴预设提示词并回车 */
        macro_zhcn: macro_zhcn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V) &kp RET>;
        };

        /* K3：git add . */
        macro_git: macro_git {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&kp G &kp I &kp T &kp SPACE>
                , <&kp A &kp D &kp D &kp SPACE>
                , <&kp DOT &kp RET>;
        };

        /* K4：npm run dev */
        macro_npm: macro_npm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&kp N &kp P &kp M &kp SPACE>
                , <&kp R &kp U &kp N &kp SPACE>
                , <&kp D &kp E &kp V &kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
                &macro_claude  &macro_zhcn  &macro_git   &macro_npm
                &kp C_VOL_DN   &kp C_VOL_UP &kp C_MUTE   &out OUT_TOG
            >;
        };
    };
};